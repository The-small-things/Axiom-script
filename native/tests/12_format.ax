^main:
  x = 3.14159
  n = 42
  print(f"[{x:.2f}] [{n:>5}] [{n:05d}] [{1234567.891:,.2f}] [{0.256:.1%}] [{255:x}] [{255:X}] [{5:b}] [{8:o}]")
  print(f"[{"hi":^9}] [{"hi":*>6}] [{"hello":.3}] [{-3.5:08.2f}] [{3:+d}] [{-7:=+6}] [{x:e}] [{x:.3e}] [{n}] [{x:10}]")
  print(f"[{0.5:.0f}] [{1.5:.0f}] [{2.5:.0f}] [{1.005:.2f}] [{1.25:.1f}] [{-0.001:.2f}] [{1e21:.2f}] [{123456789012:,}]")
  a = 1
  print(f"[{a > 0 ? "yes" : "no"}] [{a ? 1 :2}] [{ {k: 1}.k }] [{[1, 2]:>8}] [{idle:>6}] [{v3(1, 2, 3):>12}]")
  print(f"[{0:e}] [{0.000123:.2e}] [{9.99:.1e}] [{9.96:.1f}] [{99.5:.0f}] [{-0.0:.1f}] [{1/0:>9}] [{0/0:+}] [{-255.9:x}]")
  print(f"[{12:^7}] [{12:<5}|] [{"é":_^5}] [{"naïve":.3}] [{1e-7:.3f}] [{123.456:,.1f}] [{-1234.5:,}] [{1234:+,d}]")
  print(f"[{0.1 + 0.2:.17f}] [{2 ** 53:,}] [{5e-324:.2e}] [{1.7976931348623157e308:.3e}] [{true:>6}] [{null:>6}]")
  items = [["apple", 1.5, 3], ["kiwi", 0.25, 12]]
  *it in items:
    print(f"{it[0]:<8}{it[1]:>6.2f}{it[2]:>4}")
  t = 7
  print(f"{t:03}|{t * 1.0:.1f}|{"x" + str(t):>4}|{{literal}}|{t:}")
  fmt = \v: f"{v:08.3f}"
  print(map([1, -2.5, 1000], fmt))
