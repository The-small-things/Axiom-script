// big(x): JavaScript's BigInt semantics in both runtimes — construction, arithmetic, comparison,
// display, and the errors for mixing a big with a number or handing one to Math.
^fn t(label, f):
  ^try:
    print(label, "=>", f())
  ^catch e:
    print(label, "!!", e.code, e.msg)

^main:
  t("big(5)", \: big(5))
  t("big str", \: big("123456789012345678901234567890"))
  t("big neg str", \: big("-42"))
  t("big spaces", \: big(" 42 "))
  t("big hex", \: big("0x1f"))
  t("big 12e3", \: big("12e3"))
  t("big 7.9", \: big(7.9))
  t("big -7.9", \: big(-7.9))
  t("big true", \: big(true))
  t("big null", \: big(null))
  t("big [1]", \: big([1]))
  t("big 1e30", \: big(1e30))
  t("big NaN", \: big(0 / 0))
  t("big x", \: big("x"))
  t("big empty", \: big(""))
  t("big big", \: big(big(3)))
  t("add", \: big(2) + big(3))
  t("sub", \: big(2) - big(30))
  t("mul", \: big("99999999999999999999") * big("99999999999999999999"))
  t("div", \: big(7) / big(2))
  t("div neg", \: big(-7) / big(2))
  t("mod", \: big(7) % big(3))
  t("mod neg", \: big(-7) % big(3))
  t("div0", \: big(7) / big(0))
  t("mod0", \: big(7) % big(0))
  t("pow", \: big(2) ** big(100))
  t("pow num", \: big(2) ** 3)
  t("mix add", \: big(2) + 1)
  t("mix add2", \: 1 + big(2))
  t("str add", \: "n=" + big(2))
  t("str add2", \: big(2) + "x")
  t("neg", \: -big(5))
  t("eq", \: big(5) == 5)
  t("eq2", \: big(5) == big(5))
  t("ne", \: big(5) != 5)
  t("lt", \: big(5) < 6)
  t("lt2", \: big(5) < big(6))
  t("gt", \: big("100000000000000000000") > 1e19)
  t("le", \: big(5) <= 5)
  t("type", \: type(big(5)))
  t("is_big", \: is_big(big(5)))
  t("is_big n", \: is_big(5))
  t("str", \: str(big(5)))
  t("fstr", \: f"{big(5)}")
  t("fspec", \: f"{big(5):>4}")
  t("fspec d", \: f"{big(5):05d}")
  t("fspec f", \: f"{big(5):.2f}")
  t("to_json", \: to_json(big(5)))
  t("to_json arr", \: to_json([big(5)]))
  t("abs", \: abs(big(-5)))
  t("max", \: max(big(1), big(2)))
  t("int", \: int(big(5)))
  t("float", \: float(big(5)))
  t("truthy0", \: big(0) ? "t" : "f")
  t("truthy1", \: big(1) ? "t" : "f")
  t("not", \: !big(0))
  t("in", \: big(2) in [big(1), big(2)])
  t("in num", \: 2 in [big(1), big(2)])
  t("sort", \: [big(3), big(1), big(2)].sorted())
  t("sort mixed", \: [big(3), 1, 2.5].sorted())
  t("sum", \: [big(3), big(1)].sum())
  t("len", \: len(str(big(2) ** big(64))))
  t("dict key", \: {a: big(1)}.a)
  t("print arr", \: [big(1), 2])
  t("band", \: band(big(6), big(3)))
  t("bor", \: bor(big(6), 3))
  t("bxor", \: bxor(6, big(3)))
  t("shl", \: shl(big(1), 70))
  t("shr", \: shr(big(-9), 1))
  t("bnot", \: bnot(big(5)))
  t("inc", \: big(1) + big(1) == big(2))
  t("range", \: range(big(3)))
  t("floor", \: floor(big(3)))
  t("sqrt", \: sqrt(big(4)))
  t("num()", \: num(big(4)))
  t("big.method", \: big(12).str())
  t("min arr", \: [big(4), big(2)].min())
  t("uniq", \: [big(4), big(4)].uniq())
  t("hash key", \: {}.set(str(big(4)), 1))
  t("cmp str", \: big(5) == "5")
  t("mul big frac", \: big(5) * 0.5)
  t("big pow neg", \: big(2) ** big(-1))
  t("big 2**53+1", \: big(2) ** big(53) + big(1))
  t("big(2**53+1)", \: big(9007199254740993))
  t("print", \: print(big(7)))
  t("eprint", \: 1)
  t("json parse", \: from_json("12345678901234567890"))
  t("match", \: 1)
  ?* big(3):
    big(3): print("matched big 3")
    3: print("matched 3")
    _: print("matched none")
  x = big(10)
  x += big(5)
  print("compound", x)
  x -= 1
