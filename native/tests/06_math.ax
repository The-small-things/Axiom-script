// Numbers: rounding, integer maths, statistics, seeded randomness.
^main:
  print(abs(-3), floor(2.7), ceil(2.1), round(2.5), round(-2.5), trunc(-2.7), sign(-5))
  print(sqrt(16), pow(2, 10), 2 ** 10, exp(0), log(1))
  print(min(3, 1, 2), max([4, 9, 2]))
  print(mod(-1, 5), -1 % 5, divmod(-7, 3))
  print(gcd(12, 18), lcm(4, 6), fact(6), comb(5, 2), perm(5, 2))
  print(is_prime(97), len(primes(30)), isqrt(50))
  print(clamp(15, 0, 10), lerp(0, 10, 0.25), inv_lerp(0, 10, 2.5), round_to(7.3, 0.5))
  print(to_fixed(2/3, 4), 1/3)
  print(stdev([5,5,5]), variance([1,2,3,4]), mode([1,2,2,3]))
  seed(7)
  a = [random_int(1, 100), random_int(1, 100)]
  seed(7)
  b = [random_int(1, 100), random_int(1, 100)]
  print(a == b, a)
  seed(1)
  print(sorted(shuffle([1,2,3,4,5])))
  print(0.1 + 0.2, 1e21, 1.5e-7, 100000, 1000000000000)
