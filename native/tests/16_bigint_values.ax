// Bigs in containers, strings, JSON, sets, sorting and library calls.
^type Acct: owner, balance

^fn t(label, f):
  ^try:
    print(label, "=>", f())
  ^catch e:
    print(label, "!!", e.code, e.msg)

~G: big(7)

^main:
  d = {a: big(1), b: 2}
  t("print dict", \: d)
  t("str dict", \: str(d))
  t("fstr dict", \: f"{d}")
  t("record", \: Acct("x", big(5)))
  t("to_json dict", \: to_json(d))
  t("json_stringify", \: json_stringify([big(1)]))
  t("concat", \: "d=" + d)
  t("arr", \: [big(1), [big(2)], "s"])
  t("fmt", \: f"{big(12345):.2f}|{big(-5):>6}|{big(5):<4}|{big(5):^5}|{big(7):x}|{big(7):,}|{big(1234567):,}")
  t("uniq", \: [big(1), big(1), 1].uniq())
  t("group", \: [big(1), big(2), big(1)].group_by(\x: x))
  t("dict key", \: {}.set(big(3), "x"))
  t("index", \: [10, 20, 30][big(1)])
  t("str index", \: "abc"[big(2)])
  t("method", \: big(5).str())
  t("ufcs", \: big(5).is_big())
  t("len", \: len(big(12345)))
  t("in str", \: big(23) in "12345")
  t("in range", \: big(2) in 0..5)
  t("global", \: G + big(1))
  t("ternary", \: big(0) ? 1 : 2)
  t("and", \: big(0) && 5)
  t("or", \: big(0) || 5)
  t("coalesce", \: null ?? big(3))
  t("neg zero", \: -big(0))
  t("cmp str", \: big(5) < "10")
  t("cmp bad str", \: big(5) < "x")
  t("cmp null", \: big(-1) < null)
  t("cmp bool", \: big(1) >= true)
  t("cmp arr", \: big(1) < [2])
  t("eq arr", \: [big(1)] == [big(1)])
  t("deep_eq", \: deep_eq({a: big(1)}, {a: big(1)}))
  t("max_by", \: [big(2), big(10)].max_by(\x: x))
  t("sort_by", \: [big(2), big(10), big(1)].sort_by(\x: x))
  t("sorted mixed", \: [big(2), 10, big(1), 1.5].sorted())
  t("reverse", \: [big(1), big(2)].reversed())
  t("join", \: [big(1), big(2)].join("-"))
  t("sum sel", \: [{n: big(2)}, {n: big(3)}].sum("n"))
  t("mean", \: [big(2), big(4)].mean())
  t("int str", \: int("12345678901234567890"))
  t("big of big", \: big(big("123456789012345678901234567890")))
  t("big of float str", \: big("1.5"))
  t("big vec", \: big(v3(1, 2, 3)))
  t("big dict", \: big({a: 1}))
  t("big arr2", \: big([1, 2]))
  t("big nested", \: big([[7]]))
  t("big bool str", \: big([true]))
  t("big inf", \: big(1 / 0))
  print(big(9) ** big(20))
  ^return big(42)
