// < <= > >= between values of every kind, as JavaScript compares them: both sides to
// primitives (an array is its joined text, a dict "[object Object]"), two strings by UTF-16
// units, anything else as numbers, and NaN makes all four false.
^main:
  vals = [true, false, 0, 1, 2, 10, -1, 0 / 0, "", "a", "1", "10", "9", " 3", "1e1", "0x10", null, [], [1], [2, 3], [10], [[1]], {a: 1}, big(5), "Z", "é", "😀", chr(65374)]
  print(map(vals, \a: map(vals, \b: (a < b ? "<" : "") + (a <= b ? "l" : "") + (a > b ? ">" : "") + (a >= b ? "g" : "") + ".").join("")))
