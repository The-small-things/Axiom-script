// Strings, formatting, regex, JSON, encoding.
^main:
  s = "Hello, World"
  print(s.upper(), s.lower(), s.len())
  print(s.split(", "), s.replace("World", "there"))
  print(s.startsWith("Hell"), s.endsWith("ld"), s.includes("o, W"), s.indexOf("World"))
  print(s.slice(0, 5), s.slice(-5), "ab".repeat(3))
  print("  pad  ".trim(), "x".padStart(3, "-"), "x".padEnd(3, "."))
  print(ord("A"), chr(66), capitalize("abc"), title("hello world"))
  print("a\nb".lines(), words("  a  b "), "abc".chars())
  print(f"{1 + 1} items\tat {to_fixed(1/3, 3)}")
  print(re_test("a1", "\\d"), re_sub("a1b2", "\\d", "#"), len(re_all("a1b2", "\\d")))
  m = re_match("2024-06", "([0-9]+)-([0-9]+)")
  print(m.match, m.index, m.groups)
  print(re_split("a1b2c", "[0-9]"))
  print(to_json({a: [1, 2], b: "x"}))
  print(from_json("{\"n\": [1, 2]}").n)
  print(b64_decode(b64_encode("hi")))
  print(hash("abc") == hash("abc"))
  print(to_hex(255), to_bin(5), to_base(255, 16), parse_int("ff", 16))
