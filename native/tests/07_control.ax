// Control flow: conditionals, loops, break/continue, early return, ternaries.
^fn classify(n):
  ?n < 0:
    ^return "negative"
  ?n == 0:
    ^return "zero"
  ?!:
    ^return n > 100 ? "big" : "small"

^fn first_even(xs):
  *v in xs:
    ?v % 2 != 0: ~continue
    ^return v
  ^return -1

^main:
  *n in [-1, 0, 5, 500]:
    print(n, classify(n))
  print(first_even([1, 3, 4, 6]))
  n = 0
  *i in 0..5:
    *j in 0..5:
      ?j == 2: ~break
      n += 1
  print(n)
  i = 0
  *i < 3:
    i += 1
  print(i)
  x = 5
  print(x > 3 ? "gt" : x > 1 ? "mid" : "low")
  print(? x == 5 : "five" : "other")
  y = null
  print(y ?? "default")
  y ??= "set"
  print(y)
  z = 1
  z += 2
  z *= 3
  z -= 1
  z /= 2
  print(z)
  ++z
  print(z)
  flag = false
  ?!flag:
    print("not flag")
  s = ""
  *c in "abc":
    s += c.upper()
  print(s)
