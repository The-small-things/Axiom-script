// .glb meshes: from a file (two meshes, three primitives) and inline. Each registers #X and
// #X_0, #X_1, …; a mesh that does not load stays a plain descriptor with no _0.
#Mesh3D Model: "tests/engine/model.glb"
#Mesh3D Pyramid: base64("")
#Mesh3D Missing: "tests/engine/nope.glb"
@Viewer
  ~done: false
  &tick(60hz):
    ?!done:
      done = true
      print(#Model, #Model_0, #Model_1, #Model_2, #Pyramid, #Pyramid_0)
      m = #Model
      m1 = #Model_1
      m2 = #Model_2
      p = #Pyramid
      p0 = #Pyramid_0
      x = #Missing
      print(m.glb, m.material, m1.material, m2.material, m2.path, p.inline, p.path, p0.path, p0.material, x.glb, x.path)
      print(keys(m), keys(m1), keys(p0), keys(x))
      print(len(m.vertices), len(m.indices), m.indices[5], m.vertices[1], len(p0.vertices), p0.vertices[3])
      print(#Missing_0)
  &render:
    !mesh(#Model_0, color: 0x88ccff)
