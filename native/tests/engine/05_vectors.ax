@Math
  ~a: v3(1, 2, 3)
  ~b: 2v
  ~c: v2(3, 4)
  ~out: []
  &tick(1hz):
    out.push(a + b)
    out.push(a - b)
    out.push(a * 2)
    out.push(3 * a)
    out.push(a * b)
    out.push(a / 4)
    out.push(a · b)
    out.push(a × b)
    out.push(a.mag)
    out.push(a.norm)
    out.push(c.mag)
    out.push(c.norm)
    out.push(c.angle)
    out.push(c + v2(1, 1))
    out.push(a + c)
    out.push(-a)
    out.push(a.xy)
    out.push(a.xz)
    out.push(a.to(v3(10, 2, 3), 1.5))
    out.push(a.lerp(v3(0, 0, 0), 0.25))
    out.push(a.reflect(v3(0, 1, 0)))
    out.push(c.rotate(1.2))
    out.push(a.clamp(1.5, 2.5))
    qa = q(v3(0, 1, 0), 1.1)
    qb = euler(0.3, 0.2, 0.1)
    out.push(qa)
    out.push(qb)
    out.push(qa * qb)
    out.push(qa * a)
    out.push(a.rotate(qa))
    out.push(qa.slerp(qb, 0.3))
    out.push(qb.euler)
    out.push(qa.conj)
    out.push(dist(a, b))
    out.push(dist(3, 7.5))
    out.push(v3(1, 2))
    out.push(v3(5))
    out.push(v3y(2))
    out.push(v2dir(0.5))
    m = lookat(v3(0, 5, 10), v3(0, 0, 0))
    out.push(m * v3(1, 1, 1))
    out.push(m.inv * (m * v3(1, 2, 3)))
    out.push(pose.toMat4() * v3(1, 1, 1))
    out.push(f"{a} {c} {qa}")
    out.push(type(a))
    out.push(type(qa))
