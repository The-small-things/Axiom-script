// Regular expressions are JavaScript's in both runtimes: the constructs a program reaches for,
// the replacement and split rules, the flags, and the errors for malformed patterns.
^fn t(label, f):
  ^try:
    print(label, "=>", f())
  ^catch e:
    print(label, "!!", e.code, e.msg)

^main:
  log = "2024-01-15 ERROR disk full; 2024-01-16 WARN cpu 93%; 2024-01-17 ERROR net down"
  t("dates", \: map(re_all(log, "(?<y>\\d{4})-(?<m>\\d\\d)-(?<d>\\d\\d)"), \m: m.groups))
  t("lazy", \: re_match("<b>bold</b><i>it</i>", "<(.+?)>").groups)
  t("greedy", \: re_match("<b>bold</b><i>it</i>", "<(.+)>").groups)
  t("lookahead", \: re_all("price: 30USD 45EUR 12USD", "\\d+(?=USD)"))
  t("lookbehind", \: re_all("$12 and €30 and $7", "(?<=\\$)\\d+"))
  t("neg lookbehind", \: re_all("x1 y2 x3", "(?<!x)\\d"))
  t("backref", \: re_all("hello  world wood book", "\\b\\w*(\\w)\\1\\w*\\b"))
  t("named backref", \: re_test("abcabc", "^(?<p>abc)\\k<p>$"))
  t("swap", \: re_sub("John Smith", "(\\w+)\\s(\\w+)", "$2, $1"))
  t("named swap", \: re_sub("2024-01-15", "(?<y>\\d+)-(?<m>\\d+)-(?<d>\\d+)", "$<d>/$<m>/$<y>"))
  t("special $", \: re_sub("cost", "o", "[$$|$&|$`|$']"))
  t("$nn", \: re_sub("abcdefghijk", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)", "$11-$10-$1-$01-$0"))
  t("split caps", \: re_split("a1b22c", "(\\d)+"))
  t("split empty", \: re_split("abc", ""))
  t("split u", \: re_split("a😀b", "", "u"))
  t("split units", \: re_split("a😀b", ""))
  t("i", \: re_all("Straße STRASSE strasse", "strasse", "i"))
  t("iu sigma", \: re_all("ΣΑΣ σας", "σ", "iu"))
  t("kelvin", \: [re_test("K", "k", "i"), re_test("K", "k", "iu"), re_test(chr(8490), "k", "iu"), re_test(chr(8490), "\\w", "iu")])
  t("m", \: re_all("one\ntwo\nthree", "^\\w+$", "m"))
  t("s", \: [re_test("a\nb", "a.b"), re_test("a\nb", "a.b", "s")])
  t("y", \: [re_all("aaba", "a", "y"), re_sub("aaba", "a", "-", "y")])
  t("dot u", \: [re_all("a😀", "."), re_all("a😀", ".", "u")])
  t("props", \: re_all("Hello Мир 世界 123 ٣", "\\p{L}+|\\p{Nd}+", "u"))
  t("script", \: re_all("Hello Мир 世界", "\\p{Script=Cyrillic}+|\\p{sc=Han}+", "u"))
  t("emoji", \: re_all("hi 👍🏽 🇫🇷 #️⃣ 😀", "\\p{RGI_Emoji}", "v"))
  t("set ops", \: re_all("hello world", "[\\p{L}--[aeiou]]+", "v"))
  t("strings", \: re_all("abcxd", "[\\q{abc|x}]", "v"))
  t("legacy", \: [re_test("a{", "a{"), re_test("\u0008", "[\\b]"), re_test("\\c", "\\c"), re_test("\u0001", "\\01")])
  t("ws", \: re_split("a" + chr(160) + "b" + chr(12288) + "c", "\\s"))
  t("match method", \: "hello".match("l+"))
  t("match g", \: re_match("a1b2c3", "\\d", "g"))
  t("unclosed", \: re_test("x", "(a"))
  t("repeat", \: re_test("x", "*a"))
  t("range", \: re_test("x", "[z-a]"))
  t("dup name", \: re_test("x", "(?<a>.)(?<a>.)"))
  t("bad ref", \: re_test("x", "(?<a>.)\\k<b>"))
  t("u escape", \: re_test("x", "\\q", "u"))
  t("flags", \: re_test("x", "x", "gg"))
  t("uv", \: re_test("x", "x", "uv"))
  t("method error", \: "x".match("[" ))
  t("newline in error", \: re_test("x", "a\n("))
