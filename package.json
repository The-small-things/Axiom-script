{
  "name": "axiomscript",
  "version": "0.8.17",
  "description": "AxiomScript — a declarative scripting language for game worlds. Static checker + interpreter + 3D renderer reference implementation. Written by LLMs, for LLMs — token-count is the sole design metric.",
  "main": "main.js",
  "bin": {
    "axiomscript": "./main.js",
    "axiom": "./main.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node lint.js",
    "test": "node run_all_tests.js",
    "test:file": "node",
    "prepare": "node -e \"if(require('fs').existsSync('.githooks')){require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'inherit'})}\""
  },
  "license": "MIT",
  "keywords": [
    "game",
    "scripting",
    "language",
    "interpreter",
    "llm",
    "ai",
    "3d",
    "rasterizer"
  ],
  "files": [
    "*.js",
    "*.md",
    "*.nav",
    "*.ax"
  ]
}
