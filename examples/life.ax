// Conway's Game of Life — a simulation with no engine, rendered as text.
// Run: node main.js examples/life.ax -- 12
~W: 20
~H: 10

^fn wrap_idx(v, n) = mod(v, n)

^fn neighbours(grid, x, y):
  n = 0
  *dy in range(-1, 2):
    *dx in range(-1, 2):
      ?dx == 0 && dy == 0: ~continue
      n += grid[wrap_idx(y + dy, H)][wrap_idx(x + dx, W)]
  ^return n

^fn step(grid) = grid(H, W, \y, x: alive(grid[y][x], neighbours(grid, x, y)))

^fn alive(cell, n) = n == 3 || (cell == 1 && n == 2) ? 1 : 0

^fn draw(g) = g.map(\row: row.map(\c: c == 1 ? "#" : ".").join("")).join("\n")

^main(argv):
  seed(42)
  board = grid(H, W, \y, x: random() < 0.3 ? 1 : 0)
  gens = len(argv) > 0 ? parse_int(argv[0]) : 6
  *gen in range(0, gens):
    print(f"gen {gen}")
    print(draw(board))
    board = step(board)
  ^return 0
